{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://term-prep-platform/contracts/sse/event-envelope.schema.json",
  "$comment": "Implementation note: JSON Schema 2020-12 does not natively support 'discriminator'. Treat the discriminator block as an implementation guide — use the top-level 'event' field to select the 'data' shape before validation. OpenAPI-aware toolchains (Redocly, Stoplight) interpret the discriminator correctly.",
  "title": "SSE Event Envelope",
  "type": "object",
  "required": ["event", "job_id", "sequence", "timestamp", "data"],
  "properties": {
    "event": {
      "type": "string",
      "enum": ["status", "progress", "result", "error", "heartbeat"],
      "description": "Event type. Use this field to select the expected shape of 'data' before parsing."
    },
    "job_id": {
      "type": "string",
      "description": "Job identifier matching the AsyncJobStatus job_id."
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonically increasing counter per job stream. Gaps indicate missed events; duplicates indicate replay."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "description": "Event payload. Shape is determined by the 'event' field (see discriminator mapping).",
      "oneOf": [
        { "$ref": "#/$defs/statusData" },
        { "$ref": "#/$defs/progressData" },
        { "$ref": "#/$defs/resultData" },
        { "$ref": "#/$defs/errorData" },
        { "$ref": "#/$defs/heartbeatData" }
      ],
      "discriminator": {
        "propertyName": "event",
        "mapping": {
          "status": "#/$defs/statusData",
          "progress": "#/$defs/progressData",
          "result": "#/$defs/resultData",
          "error": "#/$defs/errorData",
          "heartbeat": "#/$defs/heartbeatData"
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "statusData": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["accepted", "running", "succeeded", "failed", "cancelled"]
        }
      },
      "additionalProperties": true
    },
    "progressData": {
      "type": "object",
      "required": ["current", "total", "unit"],
      "properties": {
        "current": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "unit": { "type": "string" }
      },
      "additionalProperties": true
    },
    "resultData": {
      "type": "object",
      "required": ["result_ref"],
      "properties": {
        "result_ref": {
          "type": "string",
          "description": "URL path to the completed job result resource."
        }
      },
      "additionalProperties": true
    },
    "errorData": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "heartbeatData": {
      "type": "object",
      "properties": {
        "interval_seconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    }
  }
}
