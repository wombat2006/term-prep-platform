{
  "version": "1.0.0",
  "project_root": "../../../techdev-cursor",
  "morphology": {
    "backend": "fugashi",
    "dictionary": "unidic-lite",
    "required": true
  },
  "corpus": {
    "description": "Docs synced from Google Drive — set files when mirror path is ready",
    "files": []
  },
  "reference_catalogs": [
    "config/fork/devassist-dictionary-v0.json",
    "docs/**/*.md",
    "README.md"
  ],
  "output": "build/glossary/candidates-techdev.json",
  "knowledge_filter": {
    "enabled": false,
    "mcp_server": "glossary-knowledge",
    "domain": "devassist-platform"
  },
  "scoring": {
    "adopt_threshold": 4,
    "hold_threshold": 2,
    "weights": {
      "in_ts_or_adr": 2,
      "multi_chapter": 2,
      "emphasis": 2,
      "english_pair": 2,
      "already_in_glossary": -10,
      "stop_noun": -5
    }
  },
  "stop_nouns": ["こと", "もの", "設定", "機能", "方法", "場合"],
  "stop_english": ["The", "API", "Config", "Type", "String", "Boolean"],
  "manual_adopt": [
    "Wall-Bounce",
    "MCP",
    "Model Context Protocol",
    "RAG",
    "DevAssist",
    "TechSapo",
    "Cursor",
    "Google Drive"
  ],
  "manual_reject": []
}
